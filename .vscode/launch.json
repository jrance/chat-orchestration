{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI (uvicorn, debug)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "--app-dir",
                "src",
                "codeless_orchestrator.server.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "FastAPI (uvicorn, reload)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "--app-dir",
                "src",
                "codeless_orchestrator.server.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "justMyCode": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}